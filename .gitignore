# Course source material — textbook chapters, practice exams, homework sets.
# Unanchored on purpose: this catches prep/ at any depth, in every guide.
prep/

# Generated images. Every guide rebuilds its assets/ from scratch each run,
# so nothing in one is worth committing. Unanchored, same reasoning as above.
assets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# uv / venv
.venv/
venv/

# OS
.DS_Store
